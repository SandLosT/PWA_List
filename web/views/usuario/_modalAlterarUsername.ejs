<div class="modal fade" id="modalAlterarUsername" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalAlterarUsernameLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered align-items-end">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="modalAlterarUsernameLabel">Alterar nome de usuário</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form class="formulario formulario--pequeno needs-validation" onsubmit="alterarUsername(event)" novalidate>
          <div class="form-floating mb-3">
            <input value="<%= username %>" type="text" class="form-control" id="usernameAntigo" placeholder="Digite o seu nome de usuário..." disabled readonly />
            <label for="usernameAntigo">Nome de usuário atual</label>
            <div class="invalid-feedback">
              Campo obrigatório!
            </div>
          </div>
          <div class="form-floating mb-3">
            <input type="text" class="form-control" name="username" id="usernameNovo" placeholder="Digite o seu nome de usuário..." required />
            <label for="usernameNovo">Nome de usuário novo</label>
            <div class="invalid-feedback">
              Campo obrigatório!
            </div>
          </div>
          <button type="submit" class="btn formulario__botao formulario__botao--enviar">Salvar</button>
        </form>
      </div>
    </div>
  </div>
</div>