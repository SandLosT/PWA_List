<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>Make It List - Meu perfil</title>
    <link rel="icon" type="image/x-icon" href="/images/favicon/favicon.ico">
    <link rel="manifest" href="/manifest.json" />
    <link rel="stylesheet" href="/styles/module/Formulario.css" />
    <%- include('../partials/_styles') %>
</head>

<body>
   
    <%- include('../partials/_header') %>

    <main class="position-relative">
      <article class="d-flex flex-column px-3">
        <section class="d-flex flex-column flex-fill">
          <div>
            <div class="d-flex align-items-center justify-content-between mt-3 mb-3">
                <div class="d-flex align-items-center">
                  <a class="btn btn-ligth" href="/">
                    <i class="fa-solid fa-arrow-left"></i>
                  </a>
                  <h3 class="m-0">Meu perfil</h3>
              </div>
              <%- include('./_contextMenuUsuario') %>
            </div>
            <hr />
          </div>
          <div class="flex-fill">
            <div class="container p-0" style="max-width: 500px;padding-bottom:80px !important;">
                <p class="h4 mb-4">Informações pessoais</p>
                <form id="formEditarUsuario" class="formulario p-0 needs-validation" onsubmit="editarUsuario(event)" novalidate >
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" name="nome" id="nome" placeholder="Digite o seu nome" disabled required />
                    <label for="nome">Nome</label>
                    <div class="invalid-feedback">
                      Campo obrigatório!
                    </div>
                  </div>
                  <div class="form-floating mb-3">
                    <input type="text" class="form-control" minlength="4" name="username" id="username" placeholder="Digite o seu nome de usuário" disabled required />
                    <label for="username">Nome de usuário</label>
                    <div class="invalid-feedback">
                      O nome de usuário deve ter pelo menos 4 caracteres!
                    </div>
                  </div>
                  <div class="formulario__rodape">
                    <button type="button" class="btn btn-primary" onclick="habilitarFormulario()">Editar</button>
                  </div>
                  <div class="formulario__rodape formulario__rodape--edit">
                    <button type="button" class="btn btn-light" onclick="desabilitarFormulario()">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                  </div>
                </form>
            </div>
          </div>
        </section>
      </article>
    </main>

    <%- include('../partials/_scripts') %>
    <%- include('../partials/_scriptsAuthentication') %>
    
    <script src="/scripts/CRUD/listaCRUD.js"></script>

    <script>
      function habilitarFormulario() {
        $('#nome').prop('disabled', false)
        $('#username').prop('disabled', false)
        $('#formEditarUsuario').addClass('formulario--aberto')
      }

      function desabilitarFormulario() {
        document.getElementById('formEditarUsuario').reset()
        $('#nome').prop('disabled', true)
        $('#username').prop('disabled', true)
        $('#formEditarUsuario').removeClass('formulario--aberto')
      }
    </script>

</body>

</html>